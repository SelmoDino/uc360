<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 128 128" width="128" height="128">
  <defs>
    <linearGradient id="grad_PNMC" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#365314"/>
      <stop offset="100%" stop-color="#1a2e05"/>
    </linearGradient>
    <filter id="shadow" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="4" stdDeviation="4" flood-opacity="0.4"/>
    </filter>
  </defs>

  <!-- Outer Emblem Shield -->
  <rect x="6" y="6" width="116" height="116" rx="28" fill="url(#grad_PNMC)" stroke="#a3e635" stroke-width="3" filter="url(#shadow)"/>
  
  <!-- Inner Ring -->
  <rect x="12" y="12" width="104" height="104" rx="22" fill="none" stroke="#ffffff" stroke-opacity="0.15" stroke-width="1.5"/>

  <!-- Icon Graphic -->
  <g transform="translate(0, -6)">
    <path d="M40 78 L64 36 L88 78 Z" fill="none" stroke="#ffffff" stroke-width="3.5" stroke-linejoin="round"/>
              <path d="M60 78 L76 52 L96 78 Z" fill="none" stroke="#a3e635" stroke-width="2.5" stroke-linejoin="round"/>
  </g>

  <!-- Title / Acronym -->
  <text x="64" y="92" text-anchor="middle" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-weight="900" font-size="14" fill="#ffffff" letter-spacing="1.5">
    PNMC
  </text>

  <!-- Subtitle Agency -->
  <text x="64" y="106" text-anchor="middle" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-weight="700" font-size="8" fill="#a3e635" letter-spacing="0.5">
    ANGRA DOS REIS
  </text>
</svg>